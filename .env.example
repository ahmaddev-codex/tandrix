# Reference list of every setting. You don't copy this file by hand:
#   Local dev:  `pnpm setup:local` writes .env.local from the local Supabase stack.
#               Then add your dev META_API_KEY there. See docs/engineering/Local_Dev.md.
#   Production: set these as deploy-platform secrets (Fly.io/Railway, EAS). Keep them off
#               developer machines; if you must, use .env.production.local (git-ignored).
# Server-only values must never appear in a client build. Client values are prefixed
# EXPO_PUBLIC_ (phone) or VITE_ (Mac renderer) and are safe to ship.

# local | production. Scripts that write data refuse to run unless this is "local".
TANDRIX_ENV=local

# ---------------------------------------------------------------------------
# Meta Model API (server only)
# Key: https://dev.meta.ai (Settings > API keys). Base URL and IDs per
# https://dev.meta.ai/docs/models — recheck before the build.
# ---------------------------------------------------------------------------
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Reasoning, vision, PDF, search grounding, structured output
META_MODEL_REASONING=muse-spark-1.3
# Screen pointing / Do it for me (computer tool). muse-wonder-1.0 is the stronger option.
META_MODEL_COMPUTER_USE=muse-spark-1.3
META_MODEL_SEGMENTATION=sam-3.1
META_MODEL_TRANSCRIBE=muse-voice-transcribe-1.0
META_ASR_REALTIME_URL=wss://api.meta.ai/v1/asr/realtime
# Per-request timeout for model calls, in milliseconds
META_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Supabase
# Project settings > API. Use the new publishable/secret keys (legacy anon and
# service_role keys also work in the same slots).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Server only: bypasses row-level security. Never ship to a client.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Local development: `pnpm env:local` writes the local stack's URL and keys to .env.local.

# Local stack only (written by `pnpm env:local`; not used in production)
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_STUDIO_URL=http://127.0.0.1:54323
# SUPABASE_MAIL_URL=http://127.0.0.1:54324
# DEV_USER_EMAIL=dev@tandrix.local
# DEV_USER_PASSWORD=          # generated

# ---------------------------------------------------------------------------
# Tandrix API (server)
# ---------------------------------------------------------------------------
API_PORT=8787
# Public URL of the deployed API (Fly.io or Railway), used in share links
API_PUBLIC_URL=http://localhost:8787
# Comma-separated origins allowed to call the API from a browser (web report, Mac renderer dev server)
CORS_ORIGINS=http://localhost:5173
# Random 32+ byte secret for signing share-link, pairing and manual-search tokens: `openssl rand -base64 32`
TOKEN_SIGNING_SECRET=
# Local only: 1 = canned procedure and highlights instead of the model (pnpm --filter @tandrix/api dev:fixtures).
# The API refuses to start with it in production.
TANDRIX_FIXTURE_MODELS=0

# ---------------------------------------------------------------------------
# Phone app (Expo) — public
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Mac app (Electron renderer, Vite) — public
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8787
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Deploy (CI secrets, not needed locally)
# FLY_API_TOKEN=            # if deploying to Fly.io
# RAILWAY_TOKEN=            # if deploying to Railway
# EXPO_TOKEN=               # EAS builds
# APPLE_ID= / APPLE_TEAM_ID= / APPLE_APP_SPECIFIC_PASSWORD=   # macOS notarisation
# ---------------------------------------------------------------------------

# Meta Wearables Device Access Toolkit: app registration values go in the native
# app config (apps/mobile), not here. See T0.2 notes in docs/engineering/spikes.md.
