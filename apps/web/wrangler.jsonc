// The website, for Cloudflare Workers Builds with its root directory set to apps/web, and for
// `pnpm --filter @tandrix/web deploy`. `pnpm run build` makes the Worker, before Wrangler runs.
// ../../wrangler.jsonc is the same Worker, for a build from the repo root: keep the two in step.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tandrix",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  // API_PUBLIC_URL is set on the Worker in Cloudflare; a deploy must not wipe it.
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  // Branch previews (npx wrangler preview) need this block, even empty.
  "previews": {},
  "observability": {
    "enabled": true,
  },
}
