# Cloudflare's headers for static files. Next's hashed files never change; the media can.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/photos/*
  Cache-Control: public, max-age=86400
/videos/*
  Cache-Control: public, max-age=86400
/audio/*
  Cache-Control: public, max-age=86400
