{
  "expo": {
    "name": "Tandrix",
    "slug": "tandrix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.tandrix.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.tandrix.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 136,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/android-icon-foreground.png"
          }
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Tandrix uses the camera to photograph equipment and check each step.",
          "microphonePermission": "Tandrix listens while you hold the talk button.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tandrix lets you choose photos of the equipment you have already taken.",
          "cameraPermission": "Tandrix uses the camera to photograph equipment and check each step.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Tandrix listens while you hold the talk button.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "scheme": "tandrix",
    "experiments": {
      "typedRoutes": true
    }
  }
}
